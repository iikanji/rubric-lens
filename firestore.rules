rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isTeacher() {
      return signedIn() && request.auth.token.teacher == true;
    }
    function isOwner() {
      return isTeacher() && resource.data.ownerUid == request.auth.uid;
    }
    function isClassTeacher(classId) {
      return isTeacher()
        && get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid;
    }

    // All mutations use trusted callable Functions. Authentication alone never
    // permits a user to enroll themselves or publish / modify feedback.
    match /projects/{projectId} {
      allow get, list: if isOwner();
      allow write: if false;
    }
    match /rubrics/{rubricId} {
      allow get, list: if isOwner();
      allow write: if false;
    }
    match /classes/{classId} {
      allow get, list: if isOwner();
      allow write: if false;

      match /invites/{emailHash} {
        allow read: if isClassTeacher(classId);
        allow write: if false;
      }
      match /members/{uid} {
        allow get: if isClassTeacher(classId) || (signedIn() && request.auth.uid == uid);
        allow list: if isClassTeacher(classId);
        allow write: if false;
      }
      match /sessions/{sessionId} {
        allow read: if isClassTeacher(classId);
        allow write: if false;

        match /presentations/{presentationId} {
          allow read: if isClassTeacher(classId);
          allow write: if false;

          match /assignments/{assignmentId} {
            allow get: if isClassTeacher(classId)
              || (signedIn() && resource.data.raterUid == request.auth.uid);
            allow list: if isClassTeacher(classId);
            allow write: if false;
          }
          match /ratings/{assignmentId} {
            allow get: if isClassTeacher(classId)
              || (signedIn() && resource.data.raterUid == request.auth.uid);
            allow list: if isClassTeacher(classId);
            allow write: if false;
          }
        }
      }
    }
    // Per-user projections contain ONLY that user's membership and assignments.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
      match /classes/{classId} {
        allow get, list: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
      match /assignments/{assignmentId} {
        allow get, list: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }
    // Secret email hashes / invitations are never client-readable.
    match /emailInvites/{hash}/{path=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
